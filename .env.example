# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
# Server-only. Used to load private analytics rows. Never expose this in the browser or to Webflow.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Server-only. Read-only Cloud Run market API. No trailing slash.
HF_MARKET_API_URL=https://your-market-api.example.run.app
